{
    // Настройки conda env
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "python-envs.pythonProjects": [],

    // === Code Runner + UTF-8 ===
    "code-runner.runInTerminal": true,
    "code-runner.runInOutput": false,
    "code-runner.clearPreviousOutput": true,
    "code-runner.showRunCommandInTerminal": true,

    // Принудительно UTF-8 для Python
    "terminal.integrated.env.windows": {
        "PYTHONIOENCODING": "UTF-8",
        "PYTHONLEGACYWINDOWSSTDIO": "0"
    },

    // Дополнительно для чистоты
    "files.encoding": "utf8",
    "python.terminal.executeInFileDir": true,
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "python.defaultInterpreterPath": "D:\\miniconda3\\envs\\dist-churn-pred-env\\python.exe",
    "terminal.integrated.profiles.windows": {
        "Command Prompt": {
            "path": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/K",
                "D:\\miniconda3\\Scripts\\activate.bat D:\\miniconda3 && conda activate dist-churn-pred-env"
            ]
        }
    }
}
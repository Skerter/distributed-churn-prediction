# ════════════════════════════════════════════════════════════════════════════
# Окружение DCP Live Demo за общим Traefik.
# На сервере: cp .env.example .env  и заполнить домены + токен бота + пароль БД.
# ════════════════════════════════════════════════════════════════════════════

# --- Домены для Traefik-роутинга ---
# Подставить реальный IP VDS вместо <SERVER_IP>.
# Браузер ходит на API напрямую, поэтому у API — отдельный публичный поддомен.
SITE_DOMAIN=dcp.<SERVER_IP>.nip.io
API_DOMAIN=api.dcp.<SERVER_IP>.nip.io
MLFLOW_DOMAIN=mlflow.dcp.<SERVER_IP>.nip.io

# --- Telegram-бот ---
TELEGRAM_BOT_TOKEN=

# --- Postgres (backend-store для MLflow) ---
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-strong-password

# --- Профиль запуска DCP ---
# pandas для демо, без Dask/k8s
DCP_PROFILE=pandas

# --- Версия образа ---
IMAGE_TAG=v0.4.0
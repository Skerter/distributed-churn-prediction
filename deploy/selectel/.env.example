# ════════════════════════════════════════════════════════════════════════════
# Environment for the DCP Live Demo behind a shared Traefik.
# On the server: copy .env.example to .env and fill in domains, bot token, and DB password.
# ════════════════════════════════════════════════════════════════════════════

# Compose project name (to avoid conflicts with other deploy/selectel/)
COMPOSE_PROJECT_NAME=dcp

# --- Domains for Traefik routing ---
# The browser talks to the API directly, so the API uses a dedicated public subdomain.
SITE_DOMAIN=churn.skerter.dev
API_DOMAIN=api.churn.skerter.dev
MLFLOW_DOMAIN=mlflow.churn.skerter.dev

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=change_me

# --- Postgres (backend store for MLflow) ---
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change_me

# --- DCP run profile ---
# Use `pandas` for the demo (no Dask/k8s)
DCP_PROFILE=pandas

# --- Image tag/version ---
IMAGE_TAG=latest